<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <UnityProjectPath>C:\Users\user\Github\Multiplay-ActionRPG-Unity\Multiplay-ActionRPG-Unity</UnityProjectPath>
        <UnityNetworkPath>$(UnityProjectPath)\Assets\Script\Network</UnityNetworkPath>
        
        <ProtoPath>Protos\protocol.proto</ProtoPath>
        
        <GeneratorPath>..\Tools\PacketHandlerGenerator</GeneratorPath>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.33.4" />
        <PackageReference Include="Grpc.Tools" Version="2.76.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    
    <ItemGroup>
        <Protobuf Include="$(ProtoPath)" GrpcServices="None" />
    </ItemGroup>
    
    <Target Name="AutoGenerateForUnity" AfterTargets="Build">

        <Message Text="==========================================" Importance="high" />
        <Message Text="Starting Unity Auto-Generation..." Importance="high" />
        <Message Text="==========================================" Importance="high" />
        
        <ItemGroup>
            <ProtocolFile Include="$(BaseIntermediateOutputPath)\**\Protocol.cs" />
        </ItemGroup>

        <Message Text="[1/3] Copying Protocol.cs to Unity..." Importance="high" />
        <Copy
                SourceFiles="@(ProtocolFile)"
                DestinationFolder="$(UnityNetworkPath)\Protocol"
                SkipUnchangedFiles="true"
                Condition="Exists('$(UnityProjectPath)')" />
        <Message Text=" Protocol.cs copied!" Importance="high" />
        
        <Message Text="[2/3] Generating PacketHandlers..." Importance="high" />
        <Exec
                Command="dotnet run --project $(GeneratorPath) -- $(ProtoPath) $(UnityNetworkPath)"
                WorkingDirectory="$(MSBuildProjectDirectory)"
                Condition="Exists('$(GeneratorPath)') AND Exists('$(UnityProjectPath)')" />
        <Message Text=" PacketHandlers generated!" Importance="high" />
        
        <Message Text="[3/3] Done!" Importance="high" />
        <Message Text="==========================================" Importance="high" />
        <Message Text=" Unity files updated successfully!" Importance="high" />
        <Message Text="  - Protocol.cs → $(UnityNetworkPath)\Protocol" Importance="high" />
        <Message Text="  - Handlers → $(UnityNetworkPath)\Handlers" Importance="high" />
        <Message Text="==========================================" Importance="high" />

    </Target>
</Project>